{
  "name": "claude-rtl-auto",
  "displayName": "Claude Code RTL – Hebrew, Arabic & Persian Support",
  "description": "Toggle RTL instantly from inside the chat — no reload, no config. Auto-detects Hebrew, Arabic and Persian per bubble in Claude Code, Cursor and Antigravity.",
  "version": "0.2.1",
  "publisher": "Sapphify",
  "license": "MIT",
  "homepage": "https://github.com/Ziondido/claude-code-rtl#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ziondido/claude-code-rtl"
  },
  "bugs": {
    "url": "https://github.com/Ziondido/claude-code-rtl/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other",
    "Language Packs"
  ],
  "keywords": [
    "rtl",
    "hebrew",
    "arabic",
    "right-to-left",
    "cursor",
    "claude-code",
    "persian",
    "bidirectional",
    "ai-chat",
    "antigravity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-rtl-auto.enable",
        "title": "Claude RTL: Enable"
      },
      {
        "command": "claude-rtl-auto.disable",
        "title": "Claude RTL: Disable"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "esbuild": "^0.24.0",
    "puppeteer": "^24.43.0",
    "typescript": "^5.7.0"
  }
}
